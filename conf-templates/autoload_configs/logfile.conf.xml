<?xml version="1.0"?>
<!--
  Console/file logging.

  mod_logfile needs an explicit profile; without one it has nothing to write to
  and runtime warnings such as "IP ... Rejected by acl" are invisible.
  The log directory comes from $${log_dir} (set in vars.xml).
-->
<configuration name="logfile.conf" description="File Logging">
  <settings>
    <param name="rotate-on-hup" value="true"/>
  </settings>
  <profiles>
    <profile name="default">
      <settings>
        <param name="logfile" value="/usr/local/freeswitch/var/log/freeswitch/freeswitch.log"/>
        <param name="rollover" value="10485760"/>
        <param name="maximum-rotate" value="5"/>
      </settings>
      <mappings>
        <!-- Map the subsystems that matter for diagnosing call setup. Without an
             explicit sofia mapping, `sofia global siptrace on` output is never
             written to the logfile. -->
        <map name="all" value="debug,info,notice,warning,err,crit,alert"/>
        <map name="console" value="console,debug,info,notice,warning,err,crit,alert"/>
        <map name="sofia" value="debug,info,notice,warning,err,crit,alert"/>
      </mappings>
    </profile>
  </profiles>
</configuration>
