<?xml version="1.0"?>
<!--
  Core switch settings.

  A switch.conf.xml was absent, so FreeSWITCH fell back to its compiled defaults.
  Only a handful of RTP parameters are read from this file by
  switch_load_core_config() in 1.11.x; notably the RTP timer is NOT one of them
  (it is a Sofia profile setting - see autoload_configs/sofia.conf.xml).

  Anything not listed here is simply ignored, so keep this file to the settings
  that provably take effect.
-->
<configuration name="switch.conf" description="Core Configuration">
  <settings>
    <!-- Keep RTP inside the range published by the image and compose file. -->
    <param name="rtp-start-port" value="16384"/>
    <param name="rtp-end-port" value="16484"/>

    <param name="max-sessions" value="1000"/>
    <param name="sessions-per-second" value="30"/>
    <!-- Debug level: this is a demo stack and the detailed call trace is the
         primary troubleshooting aid. -->
    <param name="loglevel" value="debug"/>
    <param name="dump-cores" value="no"/>
    <param name="colorize-console" value="false"/>
  </settings>
</configuration>
