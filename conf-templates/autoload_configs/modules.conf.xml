<?xml version="1.0"?>
<!--
  Minimal module set for the Kamailio + FreeSWITCH + PostgreSQL demo.
-->
<configuration name="modules.conf" description="Modules">
  <modules>
    <!-- Loggers -->
    <load module="mod_console"/>
    <load module="mod_logfile"/>

    <!-- RTP pacing. Without a real timer FreeSWITCH logs "Not using a timer"
         and never emits media, so calls connect but no audio flows. -->
    <load module="mod_timerfd"/>

    <!-- PostgreSQL backend (used by <section name="database"> / mod_pgsql) -->
    <load module="mod_pgsql"/>

    <!-- Control / event handling -->
    <load module="mod_event_socket"/>
    <load module="mod_commands"/>
    <!-- mod_dptools registers playback(), bridge(), answer(), etc. -->
    <load module="mod_dptools"/>

    <!-- Endpoint handled by Kamailio -->
    <load module="mod_sofia"/>

    <!-- The XML dialplan. Without this FreeSWITCH has no dialplan at all and
         answers every INVITE with 404 NO_ROUTE_DESTINATION. -->
    <load module="mod_dialplan_xml"/>

    <!-- Call detail records -->
    <load module="mod_xml_cdr"/>

    <!-- Codecs -->
    <load module="mod_opus"/>
    <!-- PCMU (G.711u) and PCMA (G.711a) are provided by the built-in
         CORE_PCM_MODULE, which is loaded by the core before any .so module.
         There is no mod_g711/mod_g722 module in FreeSWITCH 1.11.x. -->
    <!-- G.722 is provided by mod_spandsp together with G.711/G.726/GSM. -->
    <load module="mod_spandsp"/>

    <!-- File formats and tones -->
    <load module="mod_sndfile"/>
    <load module="mod_tone_stream"/>
    <load module="mod_native_file"/>

    <!-- Applications used by the demo dialplan. -->
    <load module="mod_say_en"/>
  </modules>
</configuration>
